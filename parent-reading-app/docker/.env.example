# ============================================
# 亲子伴读 App - 环境变量配置
# 复制此文件为 .env 并填写真实值
# ============================================

# === 数据库 ===
DB_PASSWORD=your-strong-password-here

# === JWT ===
JWT_SECRET=your-jwt-secret-key-at-least-32-chars

# === 声音克隆引擎 ===
# 可选: cosyvoice | fish_audio | elevenlabs
VOICE_CLONE_ENGINE=cosyvoice

# CosyVoice 配置（阿里开源方案，推荐中文场景）
COSYVOICE_API_URL=http://localhost:8080
COSYVOICE_API_KEY=

# Fish Audio 配置（备选方案）
FISH_AUDIO_API_KEY=

# ElevenLabs 配置（英文场景）
ELEVENLABS_API_KEY=

# === 短信服务 ===
# 可选: mock（开发环境打印到控制台）| aliyun
SMS_PROVIDER=mock
SMS_ACCESS_KEY=
SMS_SECRET_KEY=

# === 阿里云 OSS（生产环境文件存储）===
OSS_BUCKET=
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
