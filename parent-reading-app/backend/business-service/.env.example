# 亲子伴读 App - 业务服务环境变量

# 基础配置
NODE_ENV=development
PORT=3000

# 数据库（PostgreSQL）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/parent_reading?schema=public

# JWT密钥
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# AI服务地址
AI_SERVICE_URL=http://localhost:8000

# Redis
REDIS_URL=redis://localhost:6379

# CORS配置
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# 短信服务（阿里云）
SMS_PROVIDER=mock
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SIGN_NAME=亲子伴读
SMS_TEMPLATE_CODE=

# 文件上传
UPLOAD_MAX_SIZE=52428800
UPLOAD_DIR=./uploads
